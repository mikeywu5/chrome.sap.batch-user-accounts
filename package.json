    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "dotenv": "^16.6.1",
    "handsontable": "^16.0.1",
    "js-beautify": "^1.15.4",
    "monaco-editor": "^0.53.0",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "puppeteer": "^24.43.1",
