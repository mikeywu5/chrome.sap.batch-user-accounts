{
  "name": "chrome-batch-user-accounts-extension",
  "version": "1.0.0",
  "description": "A Chrome extension to batch manage user accounts.",
  "main": "background.js",
  "bin": {
    "sap-batch": "./cli/sap-batch.js"
  },
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
